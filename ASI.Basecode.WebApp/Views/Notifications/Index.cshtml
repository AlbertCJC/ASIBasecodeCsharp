@using ASI.Basecode.Services.ViewModelClasses
@model NotificationsIndexViewModel
@{
    ViewData["Title"] = "Notifications";
}

<h2 class="mb-3">Notifications (@Model.UnreadCount unread)</h2>

<div class="text-end mb-3">
    <form asp-action="MarkAllRead" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-outline-secondary">Mark all as read</button>
    </form>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>When</th>
                <th>Type</th>
                <th>Title</th>
                <th>Message</th>
                <th class="text-center">Read</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Notifications.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">No notifications.</td></tr>
            }
            @foreach (var n in Model.Notifications)
            {
                <tr class="@(n.IsRead ? "" : "table-warning")">
                    <td class="small">@n.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td class="small">@n.NotificationType</td>
                    <td><strong>@n.Title</strong></td>
                    <td class="small">@n.Message</td>
                    <td class="text-center">
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkRead" asp-route-id="@n.NotificationId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Mark read</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Read</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
