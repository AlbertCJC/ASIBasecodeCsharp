@using ASI.Basecode.Services.ViewModelClasses
@model NotificationsIndexViewModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Notifications (@Model.UnreadCount unread)</h1>
        <p class="cp-page-subtitle">Stay updated on your reservations and borrowings.</p>
    </div>
    <div class="cp-page-actions">
        <form asp-action="MarkAllRead" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm">Mark all as read</button>
        </form>
    </div>
</div>

@if (!Model.Notifications.Any())
{
    <div class="cp-empty-state">
        <div class="cp-empty-state-icon"><i class="fa-solid fa-bell-slash"></i></div>
        <div class="cp-empty-state-text">No notifications.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Type</th>
                    <th>Title</th>
                    <th>Message</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model.Notifications)
                {
                    <tr style="@(n.IsRead ? "" : "background:var(--color-warning-bg);")">
                        <td style="font-size:11.6px;white-space:nowrap;">@n.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td style="font-size:11.6px;">@n.NotificationType</td>
                        <td style="font-weight:600;">@n.Title</td>
                        <td style="font-size:12px;">@n.Message</td>
                        <td class="text-center">
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" asp-route-id="@n.NotificationId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="cp-btn cp-btn-primary cp-btn-sm">Mark read</button>
                                </form>
                            }
                            else
                            {
                                <span class="cp-badge cp-badge-success">Read</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}