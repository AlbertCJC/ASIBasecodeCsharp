@using ASI.Basecode.Services.ViewModelClasses
@model ActiveBorrowingsIndexViewModel
@{
    ViewData["Title"] = "Active Borrowings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Active Borrowings</h2>
        <div class="text-muted">Equipment currently released to borrowers.</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Borrowings" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="search" value="@Model.Search" class="form-control"
                       placeholder="Search by borrower, equipment or transaction number..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
                <a asp-action="Borrowings" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Transaction #</th>
                <th>Borrower</th>
                <th>Equipment</th>
                <th class="text-center">Qty</th>
                <th>Released</th>
                <th>Due</th>
                <th>Overdue</th>
                <th>Released By</th>
                <th class="text-center">Inspection</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Page.Items.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-4">No active borrowings.</td></tr>
            }
            @foreach (var b in Model.Page.Items)
            {
                <tr class="@(b.IsOverdue ? "table-danger" : "")">
                    <td><strong>@b.TransactionNumber</strong></td>
                    <td>@b.BorrowerName</td>
                    <td>
                        @b.EquipmentName
                        <div class="text-muted small">@b.AssetCode</div>
                    </td>
                    <td class="text-center">@b.ReleasedQuantity</td>
                    <td class="small">@b.ReleasedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td class="small @(b.IsOverdue ? "text-danger fw-bold" : "")">@b.DueAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td class="small">
                        @if (b.IsOverdue)
                        {
                            <span class="badge bg-danger">Overdue @b.DaysOverdue d</span>
                        }
                        else
                        {
                            <span class="badge bg-success">On time</span>
                        }
                    </td>
                    <td class="small">@(b.ReleasedBy ?? "—")</td>
                    <td class="text-center small">@b.InspectionStatus</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Page.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Borrowings" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page.Page ? "active" : "")">
                    <a class="page-link" asp-action="Borrowings" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Borrowings" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </nav>
}
