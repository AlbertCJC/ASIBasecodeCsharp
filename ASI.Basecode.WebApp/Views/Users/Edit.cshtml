@using ASI.Basecode.Services.ViewModelClasses
@model UserFormViewModel
@{
    ViewData["Title"] = "Edit User";
}

<h2 class="mb-3">Edit User</h2>
<p class="text-muted">Fields marked with an asterisk are required. Deleting a user account is blocked while borrowings, reservations or inventory movements reference it.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.UserId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <partial name="_UserForm" model="Model" />
        </form>
    </div>
</div>
