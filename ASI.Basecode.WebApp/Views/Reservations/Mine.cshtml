@using ASI.Basecode.Services.ViewModelClasses
@model ReservationMineViewModel
@{
    ViewData["Title"] = "My Reservations";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">My Reservations</h1>
        <p class="cp-page-subtitle">Track your equipment reservation requests.</p>
    </div>
    <div class="cp-page-actions">
        <a asp-action="Available" class="cp-btn cp-btn-primary"><i class="fa-solid fa-plus"></i> New Reservation</a>
    </div>
</div>

@if (!Model.Reservations.Any())
{
    <div class="cp-empty-state">
        <div class="cp-empty-state-icon"><i class="fa-solid fa-calendar-xmark"></i></div>
        <div class="cp-empty-state-text">You have no reservations yet.</div>
        <a asp-action="Available" class="cp-btn cp-btn-primary" style="margin-top:12px;">Browse Equipment</a>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Reservation #</th>
                    <th>Equipment</th>
                    <th class="text-center">Qty</th>
                    <th>Pickup Point</th>
                    <th>Status</th>
                    <th>Start</th>
                    <th>Expected Return</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reservations)
                {
                    <tr>
                        <td><strong>@r.ReservationNumber</strong></td>
                        <td>
                            @r.EquipmentName
                            <div style="font-size:10.8px;color:var(--color-text-lighter);">@r.AssetCode</div>
                        </td>
                        <td class="text-center">@r.RequestedQuantity</td>
                        <td>@(r.PickupLocationName ?? "—")</td>
                        <td>
                            <span class="cp-badge @(r.StatusCode == "PENDING" ? "cp-badge-warning" : r.StatusCode == "APPROVED" ? "cp-badge-info" : r.StatusCode == "COMPLETED" ? "cp-badge-success" : r.StatusCode == "CANCELLED" ? "cp-badge-neutral" : "cp-badge-error")">
                                @r.StatusDescription
                            </span>
                        </td>
                        <td style="font-size:11.6px;">@r.RequestedStartAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td style="font-size:11.6px;">@r.ExpectedReturnAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@r.ReservationId" class="cp-btn cp-btn-secondary cp-btn-sm">View</a>
                            @if (r.CanCancel)
                            {
                                <form asp-action="Cancel" asp-route-id="@r.ReservationId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm" onclick="return confirm('Cancel this reservation?');">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}