@using ASI.Basecode.Services.ViewModelClasses
@model EquipmentAvailabilityIndexViewModel
@{
    ViewData["Title"] = "Equipment Availability";
}

@functions {
    private static string GetAvailabilityBadgeClass(int availableUnits)
    {
        return availableUnits switch
        {
            <= 0 => "bg-danger-subtle text-danger",
            1 => "bg-warning-subtle text-warning",
            _ => "bg-success-subtle text-success",
        };
    }

    private static string GetAvailabilityText(int total, int available)
    {
        return available <= 0 ? $"0 of {total} units available" : $"{available} of {total} units available";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Equipment Availability</h2>
        <div class="text-muted">Browse active equipment and reserve units for custodian review.</div>
    </div>
</div>

@if (Model.Page.TotalCount > 0)
{
    <div class="text-muted small mb-2">@Model.Page.TotalCount equipment record(s) available for reservation.</div>
}

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-controller="Reservations" asp-action="Available" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="search" value="@Model.Search" class="form-control"
                       placeholder="Search by equipment name, asset code or category..." />
            </div>
            <div class="col-md-3">
                <select name="category" class="form-select" asp-items="@(ViewBag.CategoryOptions as SelectList)"></select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-filter"></i> Apply Filters
                </button>
                <a asp-controller="Reservations" asp-action="Available" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Equipment</th>
                <th>Category</th>
                <th>Location</th>
                <th>Condition</th>
                <th>Status</th>
                <th>Availability</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Page.Items.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No equipment records found. Try clearing the search or filters.
                    </td>
                </tr>
            }
            @foreach (var item in Model.Page.Items)
            {
                <tr>
                    <td>
                        <strong>@item.EquipmentName</strong>
                        <div class="text-muted small text-nowrap">@item.AssetCode</div>
                    </td>
                    <td>@item.CategoryName</td>
                    <td>@(item.LocationName ?? "—")</td>
                    <td>@item.ConditionName</td>
                    <td><span class="badge bg-secondary-subtle text-secondary">@item.OperationalStatusName</span></td>
                    <td>
                        <span class="badge @GetAvailabilityBadgeClass(item.AvailableUnits)">@GetAvailabilityText(item.TotalQuantity, item.AvailableUnits)</span>
                    </td>
                    <td class="text-center text-nowrap">
                        @if (item.AvailableUnits > 0)
                        {
                            <a asp-controller="Reservations" asp-action="New" asp-route-id="@item.EquipmentId"
                               class="btn btn-sm btn-success">Reserve</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Unavailable</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Page.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small">
            Showing page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)
        </span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-controller="Reservations" asp-action="Available"
                   asp-route-search="@Model.Search"
                   asp-route-category="@Model.CategoryId"
                   asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page.Page ? "active" : "")">
                    <a class="page-link" asp-controller="Reservations" asp-action="Available"
                       asp-route-search="@Model.Search"
                       asp-route-category="@Model.CategoryId"
                       asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page.HasNext ? "" : "disabled")">
                <a class="page-link" asp-controller="Reservations" asp-action="Available"
                   asp-route-search="@Model.Search"
                   asp-route-category="@Model.CategoryId"
                   asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </nav>
}
