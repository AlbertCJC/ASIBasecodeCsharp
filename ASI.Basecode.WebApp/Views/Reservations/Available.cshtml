@using ASI.Basecode.Services.ViewModelClasses
@using Microsoft.AspNetCore.Mvc.Rendering
@model EquipmentAvailabilityIndexViewModel
@{
    ViewData["Title"] = "Equipment Availability";
}
@{
    var items = Model.Page?.Items ?? new List<EquipmentAvailabilityRowViewModel>();
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Equipment Availability</h1>
        <p class="cp-page-subtitle">Browse available equipment and reserve a borrowing window.</p>
    </div>
</div>

<!-- Filter bar -->
<div class="cp-filter-bar">
    <form method="get" asp-action="Available" style="display:contents;">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by name or asset code..." />
        <select name="category" class="cp-select">
            <option value="">All categories</option>
            @if (ViewBag.CategoryOptions != null)
            {
                foreach (Microsoft.AspNetCore.Mvc.Rendering.SelectListItem c in (SelectList)ViewBag.CategoryOptions)
                {
                    <option value="@c.Value" selected="@(Model.CategoryId?.ToString() == c.Value)">@c.Text</option>
                }
            }
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm"><i class="fa-solid fa-filter"></i> Apply</button>
        <a asp-action="Available" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<!-- Equipment grid -->
@if (!items.Any())
{
    <div class="cp-empty-state">
        <div class="cp-empty-state-icon"><i class="fa-solid fa-box-open"></i></div>
        <div class="cp-empty-state-text">No equipment available matching your search.</div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px;">
        @foreach (var eq in items)
        {
            <div class="cp-card" style="display:flex;flex-direction:column;gap:8px;">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                    <div>
                        <div style="font-size:14px;font-weight:700;color:var(--color-text);">@eq.EquipmentName</div>
                        <div style="font-size:11px;color:var(--color-text-lighter);">@eq.AssetCode · @eq.CategoryName</div>
                    </div>
                    <span class="cp-badge @(eq.AvailableUnits > 0 ? "cp-badge-success" : "cp-badge-error")">
                        @(eq.AvailableUnits > 0 ? "Available" : "Out of stock")
                    </span>
                </div>
                <div style="display:flex;gap:16px;font-size:11.6px;color:var(--color-text-gray);">
                    <span><i class="fa-solid fa-location-dot" style="margin-right:4px;"></i>@(eq.LocationName ?? "—")</span>
                    <span><i class="fa-solid fa-tag" style="margin-right:4px;"></i>@eq.ConditionName</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px;">
                    <div>
                        <span style="font-size:18px;font-weight:700;color:var(--color-primary);">@eq.AvailableUnits</span>
                        <span style="font-size:11px;color:var(--color-text-lighter);"> / @eq.TotalQuantity available</span>
                    </div>
                    @if (eq.AvailableUnits > 0)
                    {
                        <a asp-action="New" asp-route-id="@eq.EquipmentId" class="cp-btn cp-btn-primary cp-btn-sm">
                            <i class="fa-solid fa-calendar-plus"></i> Reserve
                        </a>
                    }
                </div>
            </div>
        }
    </div>
}

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount items)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="Available" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="Available" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="Available" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}