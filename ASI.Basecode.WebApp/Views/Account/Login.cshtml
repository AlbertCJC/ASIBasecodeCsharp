@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}
<div class="cp-auth-card">
    <h1 class="cp-auth-title">Sign In</h1>
    <p class="cp-auth-subtitle">Access your CampusPulse account</p>

    <form method="post" action="/Account/Login">
        <div class="cp-form-group">
            <label class="cp-form-label">School Email or Account ID <span class="required">*</span></label>
            <input type="text" name="userId" class="cp-input" placeholder="e.g. 2023-104857 or ml.santos@university.edu.ph" required />
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label">Password <span class="required">*</span></label>
            <input type="password" name="password" class="cp-input" placeholder="Enter your password" required />
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <label class="cp-form-hint" style="margin:0;">
                <input type="checkbox" name="rememberMe" /> Remember me
            </label>
            <a href="/Account/ForgotPassword" class="cp-auth-link" style="font-size:12px;">Forgot password?</a>
        </div>
        <button type="submit" class="cp-btn cp-btn-primary" style="width:100%;justify-content:center;">Sign In</button>
    </form>

    <div class="cp-auth-divider">or</div>

    <p class="text-center" style="font-size:12.5px;color:var(--color-text-gray);margin:0;">
        Don't have an account? <a href="/Account/Register" class="cp-auth-link">Create Account</a>
    </p>
</div>