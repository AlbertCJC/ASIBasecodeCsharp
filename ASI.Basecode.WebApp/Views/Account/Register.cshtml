@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create Account";
}
<div class="cp-auth-card cp-auth-card-wide">
    <h1 class="cp-auth-title">Create Account</h1>
    <p class="cp-auth-subtitle">Register for CampusPulse access</p>

    <form method="post" action="/Account/Register">
        <div class="row">
            <div class="col-md-6">
                <div class="cp-form-group">
                    <label class="cp-form-label">First Name <span class="required">*</span></label>
                    <input type="text" name="firstName" class="cp-input" placeholder="First name" required />
                </div>
            </div>
            <div class="col-md-6">
                <div class="cp-form-group">
                    <label class="cp-form-label">Last Name <span class="required">*</span></label>
                    <input type="text" name="lastName" class="cp-input" placeholder="Last name" required />
                </div>
            </div>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label">Account / School ID <span class="required">*</span></label>
            <input type="text" name="accountIdentifier" class="cp-input" placeholder="e.g. 2023-104857" required />
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label">School Email <span class="required">*</span></label>
            <input type="email" name="schoolEmail" class="cp-input" placeholder="your.name@university.edu.ph" required />
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label">Department</label>
            <select name="departmentId" class="cp-select">
                <option value="">— Select department —</option>
                <option value="1">College of Computer Studies</option>
                <option value="2">College of Engineering</option>
                <option value="3">Property Office</option>
                <option value="4">MIS Department Systems</option>
                <option value="5">College of Education</option>
                <option value="6">College of Accountancy</option>
            </select>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label">Role</label>
            <select name="roleId" class="cp-select">
                <option value="1">Student</option>
                <option value="2">Faculty Member</option>
            </select>
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label">Password <span class="required">*</span></label>
            <input type="password" name="password" class="cp-input" placeholder="Create a password" required />
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label">Confirm Password <span class="required">*</span></label>
            <input type="password" name="confirmPassword" class="cp-input" placeholder="Re-enter password" required />
        </div>
        <button type="submit" class="cp-btn cp-btn-primary" style="width:100%;justify-content:center;">Create Account</button>
    </form>

    <div class="cp-auth-divider">or</div>

    <p class="text-center" style="font-size:12.5px;color:var(--color-text-gray);margin:0;">
        Already have an account? <a href="/Account/Login" class="cp-auth-link">Sign In</a>
    </p>
</div>