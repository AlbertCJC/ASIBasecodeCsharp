@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}
<div class="cp-auth-card">
    <h1 class="cp-auth-title">Reset Password</h1>
    <p class="cp-auth-subtitle">Enter your new password</p>

    <form method="post" action="/Account/ResetPassword">
        <div class="cp-form-group">
            <label class="cp-form-label">New Password <span class="required">*</span></label>
            <input type="password" name="newPassword" class="cp-input" placeholder="Create a new password" required />
        </div>
        <div class="cp-form-group">
            <label class="cp-form-label">Confirm Password <span class="required">*</span></label>
            <input type="password" name="confirmPassword" class="cp-input" placeholder="Re-enter new password" required />
        </div>
        <button type="submit" class="cp-btn cp-btn-primary" style="width:100%;justify-content:center;">Reset Password</button>
    </form>

    <p class="text-center" style="font-size:12.5px;color:var(--color-text-gray);margin:16px 0 0;">
        <a href="/Account/Login" class="cp-auth-link">Back to Sign In</a>
    </p>
</div>