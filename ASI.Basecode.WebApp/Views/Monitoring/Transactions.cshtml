@using ASI.Basecode.Services.ViewModelClasses
@model TransactionMonitoringViewModel
@{
    ViewData["Title"] = "Transaction Monitoring";
}

<h2 class="mb-3">Transaction Monitoring</h2>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Transactions" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by reference, actor, equipment..." />
            </div>
            <div class="col-md-3">
                <select name="tab" class="form-select">
                    <option value="All" selected="@(Model.Tab == "All")">All transactions</option>
                    <option value="Reservations" selected="@(Model.Tab == "Reservations")">Reservations only</option>
                    <option value="Borrowings" selected="@(Model.Tab == "Borrowings")">Borrowings only</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
                <a asp-action="Transactions" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Type</th>
                <th>Reference</th>
                <th>Date</th>
                <th>Actor</th>
                <th>Equipment</th>
                <th class="text-center">Qty</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Page.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No transactions found.</td></tr>
            }
            @foreach (var t in Model.Page.Items)
            {
                <tr>
                    <td><span class="badge @(t.Type == "Reservation" ? "bg-info text-dark" : "bg-primary")">@t.Type</span></td>
                    <td><strong>@t.Reference</strong></td>
                    <td class="small">@t.Date.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td class="small">@t.Actor</td>
                    <td>
                        @t.Equipment
                        <div class="text-muted small">@t.AssetCode</div>
                    </td>
                    <td class="text-center">@t.Quantity</td>
                    <td class="small">@t.Status</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Page.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Transactions" asp-route-search="@Model.Search" asp-route-tab="@Model.Tab" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page.Page ? "active" : "")">
                    <a class="page-link" asp-action="Transactions" asp-route-search="@Model.Search" asp-route-tab="@Model.Tab" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Transactions" asp-route-search="@Model.Search" asp-route-tab="@Model.Tab" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </nav>
}
