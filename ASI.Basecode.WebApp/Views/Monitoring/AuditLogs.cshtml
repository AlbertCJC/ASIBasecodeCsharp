@using ASI.Basecode.Services.ViewModelClasses
@model AuditLogsViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Audit Logs</h1>
        <p class="cp-page-subtitle">System activity trail.</p>
    </div>
    <div class="cp-page-actions">
        <a asp-action="ExportAuditCsv" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" class="cp-btn cp-btn-secondary cp-btn-sm">
            <i class="fa-solid fa-download"></i> Export CSV
        </a>
    </div>
</div>

<div class="cp-filter-bar">
    <form method="get" asp-action="AuditLogs" style="display:contents;">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search details, reference, action..." />
        <select name="entityType" class="cp-select">
            @foreach (var et in Model.EntityTypes)
            {
                <option value="@et" selected="@(Model.EntityType == et)">@et</option>
            }
        </select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm"><i class="fa-solid fa-filter"></i> Apply</button>
        <a asp-action="AuditLogs" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state">
        <div class="cp-empty-state-icon"><i class="fa-solid fa-clipboard-list"></i></div>
        <div class="cp-empty-state-text">No audit entries found.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Reference</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Page.Items)
                {
                    <tr>
                        <td style="font-size:11.6px;white-space:nowrap;">@a.OccurredAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td style="font-size:11.6px;">@a.ActorName</td>
                        <td style="font-size:11.6px;">@a.ActionType</td>
                        <td style="font-size:11.6px;">@a.EntityType</td>
                        <td style="font-size:11.6px;">@(a.ReferenceNumber ?? "—")</td>
                        <td style="font-size:11.6px;">@(a.Details ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="AuditLogs" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="AuditLogs" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="AuditLogs" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}