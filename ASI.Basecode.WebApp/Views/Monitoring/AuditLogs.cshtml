@using ASI.Basecode.Services.ViewModelClasses
@model AuditLogsViewModel
@{
    ViewData["Title"] = "Audit Logs";
}

<h2 class="mb-3">Audit Logs</h2>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="AuditLogs" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search details, reference, action..." />
            </div>
            <div class="col-md-3">
                <select name="entityType" class="form-select">
                    @foreach (var et in Model.EntityTypes)
                    {
                        <option value="@et" selected="@(Model.EntityType == et)">@et</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
                <a asp-action="AuditLogs" class="btn btn-sm btn-outline-secondary">Clear</a>
                <a asp-action="ExportAuditCsv" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" class="btn btn-sm btn-outline-success">Export CSV</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>When</th>
                <th>Actor</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Reference</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Page.Items.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No audit entries found.</td></tr>
            }
            @foreach (var a in Model.Page.Items)
            {
                <tr>
                    <td class="small text-nowrap">@a.OccurredAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td class="small">@a.ActorName</td>
                    <td class="small">@a.ActionType</td>
                    <td class="small">@a.EntityType</td>
                    <td class="small">@(a.ReferenceNumber ?? "—")</td>
                    <td class="small">@(a.Details ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Page.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="AuditLogs" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page.Page ? "active" : "")">
                    <a class="page-link" asp-action="AuditLogs" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="AuditLogs" asp-route-search="@Model.Search" asp-route-entityType="@Model.EntityType" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </nav>
}
