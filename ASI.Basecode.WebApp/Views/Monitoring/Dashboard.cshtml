@using ASI.Basecode.Services.ViewModelClasses
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="cp-page-title" style="margin-bottom:4px;">CampusPulse Dashboard</h1>
<p class="cp-page-subtitle" style="margin-bottom:24px;">System overview and recent activity.</p>

<!-- Equipment KPIs -->
<div class="cp-kpi-grid">
    <div class="cp-kpi">
        <div class="cp-kpi-label">Equipment Records</div>
        <div class="cp-kpi-value">@Model.EquipmentRecords</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Total Units</div>
        <div class="cp-kpi-value">@Model.TotalUnits</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Available Units</div>
        <div class="cp-kpi-value">@Model.AvailableUnits</div>
    </div>
</div>

<!-- Reservations KPIs -->
<h3 style="font-size:14px;font-weight:700;color:var(--color-text-soft);margin:0 0 8px;">Reservations</h3>
<div class="cp-kpi-grid" style="grid-template-columns:repeat(7,1fr);">
    <div class="cp-kpi"><div class="cp-kpi-label">Total</div><div class="cp-kpi-value">@Model.ReservationTotal</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Pending</div><div class="cp-kpi-value" style="color:var(--color-warning);">@Model.ReservationPending</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Approved</div><div class="cp-kpi-value" style="color:var(--color-info);">@Model.ReservationApproved</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Completed</div><div class="cp-kpi-value" style="color:var(--color-success);">@Model.ReservationCompleted</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Rejected</div><div class="cp-kpi-value" style="color:var(--color-error);">@Model.ReservationRejected</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Cancelled</div><div class="cp-kpi-value">@Model.ReservationCancelled</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Expired</div><div class="cp-kpi-value">@Model.ReservationExpired</div></div>
</div>

<!-- Borrowings KPIs -->
<h3 style="font-size:14px;font-weight:700;color:var(--color-text-soft);margin:16px 0 8px;">Borrowings</h3>
<div class="cp-kpi-grid" style="grid-template-columns:repeat(6,1fr);">
    <div class="cp-kpi"><div class="cp-kpi-label">Total</div><div class="cp-kpi-value">@Model.BorrowingTotal</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Active</div><div class="cp-kpi-value" style="color:var(--color-info);">@Model.BorrowingActive</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Partial</div><div class="cp-kpi-value" style="color:var(--color-warning);">@Model.BorrowingPartial</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Returned</div><div class="cp-kpi-value" style="color:var(--color-success);">@Model.BorrowingReturned</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Overdue</div><div class="cp-kpi-value" style="color:var(--color-error);">@Model.BorrowingOverdue</div></div>
    <div class="cp-kpi"><div class="cp-kpi-label">Lost</div><div class="cp-kpi-value">@Model.BorrowingLost</div></div>
</div>

<!-- Recent activity -->
<h3 style="font-size:14px;font-weight:700;color:var(--color-text-soft);margin:24px 0 8px;">Recent Activity</h3>
<div class="cp-table-wrap">
    <table class="cp-table">
        <thead>
            <tr>
                <th>When</th>
                <th>Actor</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Reference</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.RecentAudit.Any())
            {
                <tr><td colspan="6" class="cp-empty-state" style="padding:24px;">No activity yet.</td></tr>
            }
            @foreach (var a in Model.RecentAudit)
            {
                <tr>
                    <td style="font-size:11.6px;white-space:nowrap;">@a.OccurredAtUtc.ToLocalTime().ToString("dd MMM HH:mm")</td>
                    <td style="font-size:11.6px;">@a.ActorName</td>
                    <td style="font-size:11.6px;">@a.ActionType</td>
                    <td style="font-size:11.6px;">@a.EntityType</td>
                    <td style="font-size:11.6px;">@(a.ReferenceNumber ?? "—")</td>
                    <td style="font-size:11.6px;">@(a.Details ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>