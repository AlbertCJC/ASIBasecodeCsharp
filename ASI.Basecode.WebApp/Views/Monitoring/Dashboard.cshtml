@using ASI.Basecode.Services.ViewModelClasses
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-3">CampusPulse Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Equipment Records</div>
            <div class="fs-3 fw-bold">@Model.EquipmentRecords</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Total Units</div>
            <div class="fs-3 fw-bold">@Model.TotalUnits</div>
        </div></div>
    </div>
    <div class="col">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Available Units</div>
            <div class="fs-3 fw-bold">@Model.AvailableUnits</div>
        </div></div>
    </div>
</div>

<h5 class="mb-2">Reservations</h5>
<div class="row g-3 mb-4">
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Total</div><div class="fs-4 fw-bold">@Model.ReservationTotal</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Pending</div><div class="fs-4 fw-bold text-warning">@Model.ReservationPending</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Approved</div><div class="fs-4 fw-bold text-info">@Model.ReservationApproved</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Completed</div><div class="fs-4 fw-bold text-success">@Model.ReservationCompleted</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Rejected</div><div class="fs-4 fw-bold text-danger">@Model.ReservationRejected</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Cancelled</div><div class="fs-4 fw-bold text-secondary">@Model.ReservationCancelled</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Expired</div><div class="fs-4 fw-bold text-secondary">@Model.ReservationExpired</div></div></div></div>
</div>

<h5 class="mb-2">Borrowings</h5>
<div class="row g-3 mb-4">
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Total</div><div class="fs-4 fw-bold">@Model.BorrowingTotal</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Active</div><div class="fs-4 fw-bold text-primary">@Model.BorrowingActive</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Partial</div><div class="fs-4 fw-bold text-warning">@Model.BorrowingPartial</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Returned</div><div class="fs-4 fw-bold text-success">@Model.BorrowingReturned</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Overdue</div><div class="fs-4 fw-bold text-danger">@Model.BorrowingOverdue</div></div></div></div>
    <div class="col"><div class="card"><div class="card-body text-center"><div class="text-muted small">Lost</div><div class="fs-4 fw-bold text-dark">@Model.BorrowingLost</div></div></div></div>
</div>

<h5 class="mb-2">Recent Activity</h5>
<div class="card">
    <table class="table table-sm mb-0">
        <thead class="table-light"><tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>Reference</th><th>Details</th></tr></thead>
        <tbody>
            @if (!Model.RecentAudit.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-3">No activity yet.</td></tr>
            }
            @foreach (var a in Model.RecentAudit)
            {
                <tr>
                    <td class="small">@a.OccurredAtUtc.ToLocalTime().ToString("dd MMM HH:mm")</td>
                    <td class="small">@a.ActorName</td>
                    <td class="small">@a.ActionType</td>
                    <td class="small">@a.EntityType</td>
                    <td class="small">@(a.ReferenceNumber ?? "—")</td>
                    <td class="small">@(a.Details ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
