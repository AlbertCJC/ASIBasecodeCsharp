@using ASI.Basecode.Services.ViewModelClasses
@model EquipmentFormViewModel
@{
    ViewData["Title"] = "Edit Equipment";
}

<h2 class="mb-3">Edit Equipment</h2>
<p class="text-muted">Fields marked with an asterisk are required. Deleting an equipment record is blocked while active borrowings reference it.</p>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.EquipmentId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="EquipmentId" />
            <partial name="_EquipmentForm" model="Model" />
        </form>
    </div>
</div>
