@using ASI.Basecode.Services.ViewModelClasses
@using Microsoft.AspNetCore.Mvc.Rendering
@model EquipmentIndexViewModel
@{
    ViewData["Title"] = "Equipment Administration";
}

<div class="cp-page-header">
    <div>
        <h1 class="cp-page-title">Equipment Administration</h1>
        <p class="cp-page-subtitle">System-wide equipment records, categories, locations and maintenance information.</p>
    </div>
    <div class="cp-page-actions">
        <a asp-action="Create" class="cp-btn cp-btn-success"><i class="fa-solid fa-plus"></i> Add Equipment</a>
    </div>
</div>

<!-- KPI cards -->
<div class="cp-kpi-grid">
    <div class="cp-kpi">
        <div class="cp-kpi-label">Equipment Records</div>
        <div class="cp-kpi-value">@(Model.Totals?.RecordCount ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Total Units</div>
        <div class="cp-kpi-value">@(Model.Totals?.TotalUnits ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Available</div>
        <div class="cp-kpi-value">@(Model.Totals?.AvailableUnits ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Reserved</div>
        <div class="cp-kpi-value">@(Model.Totals?.ReservedUnits ?? 0)</div>
    </div>
    <div class="cp-kpi">
        <div class="cp-kpi-label">Released</div>
        <div class="cp-kpi-value">@(Model.Totals?.ReleasedUnits ?? 0)</div>
    </div>
</div>

<!-- Filter bar -->
<div class="cp-filter-bar">
    <form method="get" asp-action="Index" style="display:contents;">
        <input type="text" name="search" value="@Model.Search" class="cp-input" placeholder="Search by asset code, name or category..." />
        <select name="category" class="cp-select" asp-items="@(ViewBag.CategoryOptions as SelectList)"></select>
        <select name="location" class="cp-select" asp-items="@(ViewBag.LocationOptions as SelectList)"></select>
        <select name="condition" class="cp-select" asp-items="@(ViewBag.ConditionOptions as SelectList)"></select>
        <select name="operationalStatus" class="cp-select" asp-items="@(ViewBag.OperationalStatusOptions as SelectList)"></select>
        <button type="submit" class="cp-btn cp-btn-secondary cp-btn-sm"><i class="fa-solid fa-filter"></i> Apply</button>
        <a asp-action="Index" class="cp-btn cp-btn-secondary cp-btn-sm">Clear</a>
    </form>
</div>

<!-- Table -->
@if (!Model.Page.Items.Any())
{
    <div class="cp-empty-state">
        <div class="cp-empty-state-icon"><i class="fa-solid fa-box-open"></i></div>
        <div class="cp-empty-state-text">No equipment records found.</div>
    </div>
}
else
{
    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Equipment</th>
                    <th>Asset Code</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th class="text-center">Qty</th>
                    <th class="text-center">Avail.</th>
                    <th>Condition</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eq in Model.Page.Items)
                {
                    <tr>
                        <td>
                            <div style="font-weight:600;">@eq.EquipmentName</div>
                            @if (!string.IsNullOrWhiteSpace(eq.Description))
                            {
                                <div style="font-size:10.8px;color:var(--color-text-lighter);">
                                    @(eq.Description.Length > 60 ? eq.Description.Substring(0, 60) + "…" : eq.Description)
                                </div>
                            }
                        </td>
                        <td style="font-family:monospace;font-size:11.6px;">@eq.AssetCode</td>
                        <td>@eq.CategoryName</td>
                        <td>@(eq.LocationName ?? "—")</td>
                        <td class="text-center">@eq.TotalQuantity</td>
                        <td class="text-center" style="@(eq.AvailableUnits <= 0 ? "color:var(--color-error);font-weight:700;" : "")">@eq.AvailableUnits</td>
                        <td>@(eq.ConditionName ?? "—")</td>
                        <td>
                            <span class="cp-badge @(eq.IsActive ? "cp-badge-success" : "cp-badge-neutral")">
                                @(eq.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@eq.EquipmentId" class="cp-btn cp-btn-secondary cp-btn-sm">View</a>
                            <a asp-action="Edit" asp-route-id="@eq.EquipmentId" class="cp-btn cp-btn-secondary cp-btn-sm" style="margin-left:4px;">Edit</a>
                            <form method="post" asp-action="Delete" asp-route-id="@eq.EquipmentId" style="display:inline;margin-left:4px;"
                                  onsubmit="return confirm('Delete this equipment record?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="cp-btn cp-btn-danger cp-btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Page != null && Model.Page.TotalPages > 1)
{
    <div class="cp-pagination">
        <span class="cp-pagination-info">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="cp-pagination-list">
            <li class="@(Model.Page.HasPrevious ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-location="@Model.LocationId" asp-route-condition="@Model.ConditionId" asp-route-operationalStatus="@Model.OperationalStatusId" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="@(p == Model.Page.Page ? "active" : "")">
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-location="@Model.LocationId" asp-route-condition="@Model.ConditionId" asp-route-operationalStatus="@Model.OperationalStatusId" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="@(Model.Page.HasNext ? "" : "disabled")">
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-category="@Model.CategoryId" asp-route-location="@Model.LocationId" asp-route-condition="@Model.ConditionId" asp-route-operationalStatus="@Model.OperationalStatusId" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </div>
}