@using ASI.Basecode.Services.ViewModelClasses
@model ReturnsIndexViewModel
@{
    ViewData["Title"] = "Return Processing";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Return Processing</h2>
        <div class="text-muted">Record equipment returns and condition inspections.</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="search" value="@Model.Search" class="form-control"
                       placeholder="Search by borrower, equipment or transaction..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Transaction #</th>
                <th>Borrower</th>
                <th>Equipment</th>
                <th class="text-center">Returned</th>
                <th>Returned At</th>
                <th>Timeliness</th>
                <th>Received By</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Page.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No returns recorded yet.</td></tr>
            }
            @foreach (var r in Model.Page.Items)
            {
                <tr>
                    <td><strong>@r.TransactionNumber</strong></td>
                    <td>@r.BorrowerName</td>
                    <td>
                        @r.EquipmentName
                        <div class="text-muted small">@r.AssetCode</div>
                    </td>
                    <td class="text-center">@r.ReturnedQuantity</td>
                    <td class="small">@r.ReturnedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        @if (r.WasReturnedLate)
                        {
                            <span class="badge bg-danger">Late @r.DaysOverdue d</span>
                        }
                        else
                        {
                            <span class="badge bg-success">On time</span>
                        }
                    </td>
                    <td class="small">@(r.ReceivedBy ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Page.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small">Page @Model.Page.Page of @Model.Page.TotalPages (@Model.Page.TotalCount records)</span>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page - 1)">‹</a>
            </li>
            @for (var p = 1; p <= Model.Page.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page.Page + 1)">›</a>
            </li>
        </ul>
    </nav>
}
